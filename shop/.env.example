# ============================================================================
#  SimShop — نمونه‌ی متغیرهای محیطی
#  این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین نمایید.
#  هرگز فایل .env را در گیت commit نکنید.
# ============================================================================

# ---------- عمومی ----------
NODE_ENV=production
APP_NAME="سیم‌شاپ"
# آدرس عمومی سایت (بدون اسلش انتهایی) — برای ساخت callback درگاه پرداخت
NEXT_PUBLIC_APP_URL=https://shop.example.ir

# ---------- دیتابیس ----------
# قالب: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://shop:CHANGE_ME@127.0.0.1:5432/shop?schema=public

# ---------- امنیت ----------
# کلید امضای نشست (حداقل ۳۲ کاراکتر تصادفی) — با دستور زیر بسازید:
#   openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_48_BYTES
# کلید محافظت از اندپوینت زمان‌بندی‌شده
CRON_SECRET=CHANGE_ME_CRON_SECRET
# هزینه‌ی bcrypt (توصیه: ۱۲ در سرور قوی، ۱۰ در سرور ضعیف)
BCRYPT_COST=12

# ---------- کش و محدودیت نرخ (اختیاری) ----------
# در صورت خالی بودن، از حافظه‌ی محلی استفاده می‌شود (مناسب تک‌سرور)
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# ---------- رمز اولیه‌ی seed ----------
# فقط هنگام اجرای `npm run db:seed` استفاده می‌شود
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================================================
#  نکته: تنظیمات درگاه پرداخت و پیامک در «پنل ادمین → تنظیمات» ثبت می‌شوند و
#  در جدول Setting (نوع SECRET) نگهداری می‌گردند؛ نیازی به تعریف در این فایل نیست:
#    - payment.zarinpal.merchantId   (زرین‌پال)
#    - payment.idpay.apiKey          (آیدی‌پی)  + payment.sandbox
#    - payment.nextpay.apiKey        (نکست‌پی)
#    - sms.kavenegar.apiKey + sms.kavenegar.sender       (کاوه‌نگار)
#    - sms.melipayamak.username/password/sender          (ملی‌پیامک)
# ============================================================================
