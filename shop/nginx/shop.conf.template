# ---------------------------------------------------------------------------
#  پیکربندی Nginx برای فروشگاه روی ساب‌دامین (RTL، HTTPS، هدرهای امنیتی)
#  این فایل به‌صورت template توسط ایمیج رسمی nginx پردازش می‌شود و
#  متغیر ${SHOP_DOMAIN} با مقدار واقعی جایگزین می‌گردد.
# ---------------------------------------------------------------------------

# محدودیت نرخ در لبه (لایه‌ی دوم دفاعی بعد از rate limit اپلیکیشن)
limit_req_zone $binary_remote_addr zone=general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=1r/s;
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;

upstream simshop_app {
    server app:3000;
    keepalive 32;
}

# --- HTTP: فقط برای چالش ACME و ریدایرکت به HTTPS ---
server {
    listen 80;
    listen [::]:80;
    server_name ${SHOP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SHOP_DOMAIN};

    # گواهی‌ها با certbot ساخته می‌شوند:
    #   docker compose run --rm certbot certonly --webroot -w /var/www/certbot \
    #     -d shop.example.ir --email info@example.ir --agree-tos --no-eff-email
    ssl_certificate     /etc/letsencrypt/live/${SHOP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SHOP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;

    # هدرهای امنیتی
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # فعال‌سازی CSP پس از اطمینان از کارکرد کامل سایت (در حالت گزارش‌دهی)
    # add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'" always;

    client_max_body_size 8M;
    client_body_timeout 30s;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    # فایل‌های استاتیک Next.js (کش طولانی)
    location /_next/static/ {
        proxy_pass http://simshop_app;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location /fonts/ {
        proxy_pass http://simshop_app;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # مسیرهای ورود: محدودیت سخت‌گیرانه‌تر
    location ~ ^/api/auth/(login|register|2fa) {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://simshop_app;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://simshop_app;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location / {
        limit_req zone=general burst=40 nodelay;
        proxy_pass http://simshop_app;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }
}
